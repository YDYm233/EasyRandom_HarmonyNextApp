<div class="container">
  <swiper class="swiper" index="1" loop="false" id="mainSwiper" onchange="onSwiperChange">
    <div class="page">
      <text class="icon">🧭</text>
      <text class="title">快捷导航</text>
      <text class="subtitle">开发中</text>
    </div>
    <div class="page page-center">
      <text class="icon">🎡</text>
      <text class="title">幸运转盘</text>
      <text class="subtitle">P0 开发中</text>
    </div>
    <div class="page">
      <text class="icon">🪵</text>
      <text class="title">祝福木鱼</text>
      <text class="subtitle">P0 开发中</text>
    </div>
    <div class="page">
      <text class="icon">💬</text>
      <text class="title">真心话大冒险</text>
      <text class="subtitle">P0 开发中</text>
    </div>
    <div class="page">
      <text class="icon">🎲</text>
      <text class="title">掷骰子</text>
      <text class="subtitle">P1 开发中</text>
    </div>
    <div class="page">
      <text class="icon">🪙</text>
      <text class="title">丢硬币</text>
      <text class="subtitle">P1 开发中</text>
    </div>
    <div class="page">
      <text class="icon">🔤</text>
      <text class="title">ABCD</text>
      <text class="subtitle">P1 开发中</text>
    </div>
    <div class="page">
      <text class="icon">☯</text>
      <text class="title">八卦占卜</text>
      <text class="subtitle">P2 开发中</text>
    </div>
    <div class="page">
      <text class="icon">🎨</text>
      <text class="title">随机颜色</text>
      <text class="subtitle">P2 开发中</text>
    </div>
  </swiper>
  <div class="dots">
    <div class="dot"></div>
    <div class="dot active"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
    <div class="dot"></div>
  </div>
</div>
